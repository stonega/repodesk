# Cloudflare configuration and OAuth lifecycle. Replace all credential placeholders.
# The token is configured in the panel, never sent to the Telegram conversation.
@origin = http://localhost:3000
@workspace = 00000000-0000-4000-8000-000000000001
@session = replace-with-your-session
@csrf = replace-with-your-csrf-token

### OAuth configuration (alternative to manual-token setup below)
# Register a Cloudflare client once with authorization_code + refresh_token grants,
# code response type, client_secret_basic, and this deployment's callback:
# http://localhost:3000/api/admin/cloudflare/callback
# Deployed sites require HTTPS. Client scopes must include Account Read and the
# permissions needed by your operations. Use exact scope IDs from Cloudflare.
PUT {{origin}}/api/admin/workspaces/{{workspace}}/plugins/cloudflare
Cookie: deepx_session={{session}}
Origin: {{origin}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{
  "revision": 0,
  "settings": {
    "enabled": false,
    "authMethod": "oauth",
    "accountId": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "zoneIds": ["bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"]
  },
  "oauthClient": {
    "clientId": "replace-with-client-id",
    "clientSecret": "replace-with-client-secret",
    "scopes": ["account.read"]
  }
}

### Start browser consent; open the returned URL in the same signed-in browser
# Use the session cookie from that browser. Add the registered API scope IDs
# needed for DNS/Pages/cache operations to the configuration above.
POST {{origin}}/api/admin/workspaces/{{workspace}}/plugins/cloudflare/oauth/connect
Cookie: deepx_session={{session}}
Origin: {{origin}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{ "revision": 1 }

# The provider callback returns to Plugins → Cloudflare, verifies the account
# and enables the plugin. Access/refresh tokens stay encrypted on the server.
# Read GET below for the current revision/status before any further save.

### Disconnect OAuth and disable the plugin (use the current revision)
POST {{origin}}/api/admin/workspaces/{{workspace}}/plugins/cloudflare/oauth/disconnect
Cookie: deepx_session={{session}}
Origin: {{origin}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{ "revision": 2 }

### Read the saved summary (contains no API token or ciphertext)
GET {{origin}}/api/admin/workspaces/{{workspace}}/plugins/cloudflare
Cookie: deepx_session={{session}}

### Manual-token alternative; disconnect OAuth first, use current revision from GET
PUT {{origin}}/api/admin/workspaces/{{workspace}}/plugins/cloudflare
Cookie: deepx_session={{session}}
Origin: {{origin}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{
  "revision": 0,
  "settings": {
    "enabled": true,
    "authMethod": "api_token",
    "accountId": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "zoneIds": ["bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"]
  },
  "apiToken": "replace-with-your-scoped-cloudflare-token"
}

# Private Telegram journey after configuration:
# 1. "Show the Cloudflare zones available in this workspace."
# 2. "List DNS records for example.com. Fetch the next page if needed."
# 3. "Show the latest Pages deployments for my-site."
# 4. Owner/admin: "Create an A record for www.example.com pointing to
#    192.0.2.10, automatic TTL, proxy disabled."
#    Inspect the complete proposal, then press its actor-bound Approve button.
# 5. Owner/admin: "Purge https://www.example.com/index.html from the cache."
#    Inspect and approve the new exact request separately.
# The bot reports completed/failed/unknown after execution. Unknown requests
# are never retried automatically; inspect Cloudflare before proposing again.

### Remove the saved token and disable; use the latest revision from GET
PUT {{origin}}/api/admin/workspaces/{{workspace}}/plugins/cloudflare
Cookie: deepx_session={{session}}
Origin: {{origin}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{
  "revision": 1,
  "settings": {
    "enabled": false,
    "authMethod": "api_token",
    "accountId": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "zoneIds": ["bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"]
  },
  "removeToken": true
}
