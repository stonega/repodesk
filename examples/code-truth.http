@origin = http://localhost:3000
@session = replace-with-authenticated-session
@csrf = replace-with-csrf-token
@workspace = 00000000-0000-4000-8000-000000000001

### Read saved configuration and current revision
GET {{origin}}/api/admin/workspaces/{{workspace}}/plugins/code-truth
Cookie: repodesk_session={{session}}

### Replace revision 0 with the revision returned above
# The repository dialog's Confirm action sends this PUT directly. Enablement
# and repository removal also save immediately using the current revision.
PUT {{origin}}/api/admin/workspaces/{{workspace}}/plugins/code-truth
Cookie: repodesk_session={{session}}
Origin: {{origin}}
x-csrf-token: {{csrf}}
Content-Type: application/json

{
  "revision": 0,
  "settings": {
    "enabled": true,
    "repositories": [{
      "repositoryUrl": "https://github.com/your-org/my-repository.git",
      "description": "Web application source and shared components.",
      "workspaces": ["{{workspace}}"]
    }]
  }
}

### Start or check the workspace's managed index (requires local service)
# An indexing/access failure here does not grant fallback source access.
# Ordinary bot chat makes no Code Truth/GitHub startup calls. Source tools check
# current permissions and service compatibility only when invoked. Restore access
# or service availability, then retry the source question.
POST {{origin}}/api/admin/workspaces/{{workspace}}/plugins/code-truth/status
Cookie: repodesk_session={{session}}
Origin: {{origin}}
x-csrf-token: {{csrf}}
Content-Type: application/json

{}
