# Use an operator session for this workspace. Never paste real session cookies into Git.
@origin = http://localhost:3000
@workspace = REPLACE_WORKSPACE_UUID
@csrf = REPLACE_CSRF_TOKEN

GET {{origin}}/api/admin/workspaces/{{workspace}}/plugins/coding

### Save the current revision returned by GET. Repository IDs must be connected.
# Configure deploy/codex/compose.yaml separately. Use a fake key in checked-in examples.
# Omit providerApiKey to preserve it; use null to remove it and restore any environment fallback.
# Responses include providerApiKeyConfigured only, never the saved key.
PUT {{origin}}/api/admin/workspaces/{{workspace}}/plugins/coding
Origin: {{origin}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{
  "revision": 0,
  "providerApiKey": "REPLACE_PROVIDER_API_KEY",
  "settings": {
    "enabled": true,
    "backend": "podman",
    "authMode": "provider_key",
    "repositories": [{
      "repositoryId": 7001,
      "baseBranch": "develop",
      "maintainers": ["101"],
      "development": {
        "executionMode": "reviewed",
        "publishByDefault": false,
        "maxAttempts": 8,
        "maxRepairAttempts": 2,
        "activeSeconds": 2700,
        "maxTokens": 200000
      }
    }]
  }
}

### For per-workspace ChatGPT sign-in, save settings with authMode "device_code"
# and omit providerApiKey. Device login must be enabled in ChatGPT settings.
# The POST response contains the verification URL and one-time code, never tokens.
POST {{origin}}/api/admin/workspaces/{{workspace}}/plugins/coding/device/start
Origin: {{origin}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{}

### Poll the coding GET above for deviceAuth.state = "connected".
# Disconnect removes the workspace login and invalidates pending approvals.
POST {{origin}}/api/admin/workspaces/{{workspace}}/plugins/coding/device/logout
Origin: {{origin}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{}

### Stop a reviewed or continuous task; publication cancellation is best-effort.
# GET returns developmentTasks separately from legacy tasks.
# Explicitly save executionMode "direct" after your dedicated live pilot checks.
POST {{origin}}/api/admin/workspaces/{{workspace}}/plugins/coding/REPLACE_TASK_UUID/cancel
Origin: {{origin}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{}
