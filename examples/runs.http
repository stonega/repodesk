# Sign in as the workspace's deployment operator or an eligible workspace owner/admin.
# Replace the workspace/run IDs and session cookie. These endpoints are read-only.
@origin = http://localhost:3000
@workspaceId = REPLACE_WITH_WORKSPACE_UUID
@runId = REPLACE_WITH_RUN_UUID
@threadId = REPLACE_WITH_THREAD_UUID_OR_run-RUN_UUID
@session = REPLACE_WITH_SESSION

### List 25 conversation threads, newest activity first.
# Each summary includes saved Telegram user/group identity and request count.
GET {{origin}}/api/admin/workspaces/{{workspaceId}}/threads?offset=0&limit=25
Cookie: repodesk_session={{session}}

### Next page of threads; pagination happens after requests are grouped.
GET {{origin}}/api/admin/workspaces/{{workspaceId}}/threads?offset=25&limit=25
Cookie: repodesk_session={{session}}

### Read the first 25 chronological request/reply pairs and whole-thread statistics.
GET {{origin}}/api/admin/workspaces/{{workspaceId}}/threads/{{threadId}}?offset=0&limit=25
Cookie: repodesk_session={{session}}

### Read later requests in the same conversation.
GET {{origin}}/api/admin/workspaces/{{workspaceId}}/threads/{{threadId}}?offset=25&limit=25
Cookie: repodesk_session={{session}}

### Open a thread; listOffset preserves the parent thread-list page.
GET {{origin}}/admin/threads/{{threadId}}?workspace={{workspaceId}}&listOffset=25
Cookie: repodesk_session={{session}}

### Fetch individual request summaries using the compatible run-history API.
GET {{origin}}/api/admin/workspaces/{{workspaceId}}/runs?offset=0&limit=25
Cookie: repodesk_session={{session}}

### Fetch one run's execution messages, model attempts and delivery details.
GET {{origin}}/api/admin/workspaces/{{workspaceId}}/runs/{{runId}}
Cookie: repodesk_session={{session}}

### Inspect a run and return to its conversation and original list/message pages.
GET {{origin}}/admin/runs/{{runId}}?workspace={{workspaceId}}&thread={{threadId}}&threadOffset=25&listOffset=25
Cookie: repodesk_session={{session}}
