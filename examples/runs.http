# Sign in as the workspace's deployment operator or an eligible workspace owner/admin.
# Replace the workspace/run IDs and session cookie. These endpoints are read-only.
@origin = http://localhost:3000
@workspaceId = REPLACE_WITH_WORKSPACE_UUID
@runId = REPLACE_WITH_RUN_UUID
@session = REPLACE_WITH_SESSION

### List 25 compact summaries (default); limit accepts 1–100, offset is non-negative.
# Response: { mode, total, offset, limit, items: [{ id, actor, status, at, model,
# taskPreview, attemptCount, deliveryStates }] }. Full records use the detail endpoint.
GET {{origin}}/api/admin/workspaces/{{workspaceId}}/runs?offset=0&limit=25
Cookie: repodesk_session={{session}}

### Fetch the next page without loading messages, attempts or delivery bodies.
GET {{origin}}/api/admin/workspaces/{{workspaceId}}/runs?offset=25&limit=25
Cookie: repodesk_session={{session}}

### Fetch one run, including messages, model attempts and delivery details.
GET {{origin}}/api/admin/workspaces/{{workspaceId}}/runs/{{runId}}
Cookie: repodesk_session={{session}}

### Open the dedicated detail page; offset preserves the return list page.
GET {{origin}}/admin/runs/{{runId}}?workspace={{workspaceId}}&offset=25
Cookie: repodesk_session={{session}}
