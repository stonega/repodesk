@baseUrl = http://localhost:3000
@csrf = REPLACE_WITH_SESSION_CSRF
@session = REPLACE_WITH_SESSION_COOKIE

### Read current version (requires an operator session)
GET {{baseUrl}}/api/setup/progress
Cookie: repodesk_session={{session}}

### Save model settings; replace version and placeholders, never commit real keys
PUT {{baseUrl}}/api/admin/operator/credentials
Origin: {{baseUrl}}
Cookie: repodesk_session={{session}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{
  "version": 1,
  "modelBaseUrl": "https://models.example.com/v1",
  "modelKey": "REPLACE_WITH_API_KEY",
  "model": "team/custom-reasoner",
  "thinkingLevel": "high",
  "modelPricing": { "input": 10, "output": 30, "currency": "CNY", "usdRate": 0.14 },
  "modelLimits": { "contextWindow": 128000, "maxOutputTokens": 16000 }
}

### Capacity values above are examples: replace with your provider's documented limits.
### Both capacity values and prices are optional, including independent overrides.
### Currency defaults to USD; non-USD prices require a positive usdRate (USD per unit).
### The example rate is illustrative, not a current exchange-rate quote.
### Catalog fallback prices, budgets and usage totals remain USD; runs pin their rate.
### Set modelLimits to null to restore automatic catalog/app default capacity.
### Missing token prices count as zero for budgets and usage; available rates still apply.

### Save workspace budgets (replace workspace ID and its current version)
PUT {{baseUrl}}/api/admin/workspaces/REPLACE_WORKSPACE_ID/settings
Origin: {{baseUrl}}
Cookie: repodesk_session={{session}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{
  "version": 1,
  "settings": {
    "name": "My team",
    "timezone": "Asia/Taipei",
    "runBudgetUsd": null,
    "monthlyBudgetUsd": null
  }
}
