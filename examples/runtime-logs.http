# Sign in as a deployment operator; replace the cookie with your local session.
# No CSRF token is required for this read-only endpoint.
GET http://localhost:3000/api/admin/operator/logs?service=worker&level=warn&q=polling&limit=50
Cookie: repodesk_session=REPLACE_WITH_SESSION

