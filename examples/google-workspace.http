# Authenticate first; keep the session cookie and CSRF token from the admin API.
# Replace workspace, revision and client settings. All five Google services share one client.
@origin = http://localhost:3000
@workspace = 00000000-0000-4000-8000-000000000001
@csrf = REPLACE_WITH_SESSION_CSRF
@session = REPLACE_WITH_SESSION_COOKIE

### Redacted settings (secret/tokens are never returned)
GET {{origin}}/api/admin/workspaces/{{workspace}}/plugins/google
Cookie: repodesk_session={{session}}

### Save a Web application OAuth client, disabled until explicitly enabled later
PUT {{origin}}/api/admin/workspaces/{{workspace}}/plugins/google
Origin: {{origin}}
Cookie: repodesk_session={{session}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{"revision":0,"settings":{"enabled":false},"clientId":"REPLACE.apps.googleusercontent.com","clientSecret":"REPLACE_WITH_CLIENT_SECRET"}

### Enable the application; individual accounts connect in Telegram
PUT {{origin}}/api/admin/workspaces/{{workspace}}/plugins/google
Origin: {{origin}}
Cookie: repodesk_session={{session}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{"revision":1,"settings":{"enabled":true}}

# In the bot's private Telegram chat:
# /google -- open consent, then confirm the displayed account in Telegram
# Starting /google in a private topic keeps the browser-return confirmation there.
# /google status
# /google connect -- reconnect your own account
# /google properties -- select up to 20 personal Search Console properties, then Save
# /google disconnect -- remove only your local account in this workspace
# All users share /api/admin/google/callback; no admin-panel session is needed for consent.
# Tool examples for an active member with their own confirmed account in a private Telegram conversation:
# query_google_docs: {"documentId":"DOCUMENT_ID"}
# query_google_sheets: {"resource":"spreadsheet","spreadsheetId":"SPREADSHEET_ID"}
# query_google_sheets: {"resource":"values","spreadsheetId":"SPREADSHEET_ID","range":"Budget!A1:D20"}
# query_google_drive: {"resource":"files","query":"Budget"}
# query_google_drive: {"resource":"file","fileId":"FILE_ID"}
# query_gmail: {"resource":"messages","query":"from:friend@example.test newer_than:7d"}
# query_gmail: {"resource":"message","messageId":"MESSAGE_ID"}
