# Search Console uses personal Google accounts. Configure the shared application
# with google-workspace.http, then use the bot's private Telegram chat:
# /google
# Complete Google consent and confirm your account in Telegram.
# /google properties
# Select up to 20 properties, page with Previous/Next, and press Save.
# /google status
# /google disconnect
#
# Natural-language requests after selection:
# List my selected Search Console properties.
# Show clicks and impressions for example.com from 2026-10-01 to 2026-10-10.
# List the sitemaps for example.com.
# Inspect Google's indexed version of https://example.com/blog/intro.
#
# Tool inputs use the requesting member's saved selection:
# query_search_console: {"resource":"properties"}
# query_search_console: {"resource":"sitemaps","siteUrl":"sc-domain:example.com"}
# query_search_console: {"resource":"analytics","siteUrl":"sc-domain:example.com","startDate":"2026-10-01","endDate":"2026-10-10"}
# Admin Search Console credential and property endpoints are retired.
