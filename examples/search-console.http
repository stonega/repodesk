@base = http://localhost:3000
@cookie = repodesk_session=REPLACE_WITH_SESSION
@csrf = REPLACE_WITH_CSRF
@workspace = 00000000-0000-4000-8000-000000000001

### Read redacted settings (workspace deployment operator)
GET {{base}}/api/admin/workspaces/{{workspace}}/plugins/search-console
Cookie: {{cookie}}

# First connect the shared Google Web application using google-workspace.http.
# Use the current plugin revision from GET; the examples below assume it is 2.

### Discover properties available to the connected Google account.
POST {{base}}/api/admin/workspaces/{{workspace}}/plugins/search-console/properties
Cookie: {{cookie}}
Origin: {{base}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{"revision": 2}

### Select exact returned property identifiers; Google access is verified.
# Enablement is controlled by the Google plugin, not this property helper.
PUT {{base}}/api/admin/workspaces/{{workspace}}/plugins/search-console
Cookie: {{cookie}}
Origin: {{base}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{"revision": 2, "settings": {"enabled": true, "siteUrls": ["sc-domain:example.com"]}}

### Clear the selected properties; Docs, Sheets, Drive and Gmail remain enabled.
PUT {{base}}/api/admin/workspaces/{{workspace}}/plugins/search-console
Cookie: {{cookie}}
Origin: {{base}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{"revision": 3, "settings": {"enabled": true, "siteUrls": []}}

### Telegram private chat examples (active workspace owner/admin)
