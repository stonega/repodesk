# Compose interpolates these; generate a unique password containing URL-safe characters.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
PUBLIC_ORIGIN=http://localhost:3000
APP_PORT=3000
ENCRYPTION_KEY_FILE=./secrets/encryption-key
# Host development (not needed for Compose):
# DATABASE_URL=postgres://deepx:password@localhost:5432/deepx
# ENCRYPTION_KEY=64-hex-characters

# For deployment after publishing a release: APP_IMAGE=registry.example/deepx@sha256:...

# Opt in to local Telegram long polling; keep webhook for public HTTPS deployments.
TELEGRAM_TRANSPORT=webhook

# Total execution time per run (1–1800 seconds); reasoning models may need longer.
RUN_TIMEOUT_SECONDS=300

# Optional legacy Pi extension manifest fallback for API and worker.
# Panel settings take precedence after each workspace’s first plugin save.
# PI_EXTENSIONS_FILE=/absolute/path/to/extensions/extensions.json
# Compose: use examples/extensions.compose.yaml for a read-only mount.

# Optional predefined Code Truth. Set both on API and worker; never expose its token to the UI.
# CODE_TRUTH_URL=http://127.0.0.1:3010
# CODE_TRUTH_TOKEN_FILE=/absolute/path/to/secrets/code-truth-token
# Compose only: private GitHub read access for the local service.
# CODE_TRUTH_GITHUB_TOKEN=

# Optional GitHub App for workspace connections (examples/github-app.compose.yaml).
# GITHUB_APP_ID=123456
# GITHUB_APP_CLIENT_ID=Iv1.replace
# GITHUB_APP_SLUG=your-app-slug
# GITHUB_APP_PRIVATE_KEY_FILE=./secrets/github-app-private-key.pem
# GITHUB_APP_CLIENT_SECRET_FILE=./secrets/github-app-client-secret

# Codex container runner.
# Stable VPS releases start the Docker runner and generate its token automatically.
# The settings below are for manual container deployments.
# CODEX_CONTAINER_ENGINE=podman
# CODEX_RUNNER_TOKEN=
# PODMAN_SOCKET=/run/user/1000/podman/podman.sock
# Custom Responses provider, matching this device's Codex configuration shape.
# Save a workspace key in Plugins > Codex.
# Optional fallback for workspaces without a saved key; never bake keys into images.
# CODEX_PROVIDER_API_KEY=
# CODEX_PROVIDER_NAME=AIAPI
# CODEX_PROVIDER_BASE_URL=https://aiapi.abmatrix.cn/v1
# CODEX_MODEL=gpt-6-astra
# CODEX_REASONING_EFFORT=high
# CODEX_RUNNER_CPUS=2
# CODEX_RUNNER_MEMORY_MB=4096
# CODEX_RUNNER_TIMEOUT_SECONDS=2700
# CODEX_RUNNER_RETENTION_HOURS=24
