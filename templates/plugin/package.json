{
  "name": "my-repodesk-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "generate": "bun .repodesk/scripts/plugin-cli.mjs generate .",
    "build": "bun .repodesk/scripts/plugin-cli.mjs build .",
    "validate": "bun .repodesk/scripts/plugin-cli.mjs validate .",
    "example": "bun .repodesk/scripts/plugin-cli.mjs run . count_words input.json fixtures.json --unsafe-local",
    "check": "biome check src tests",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.3.11",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@repodesk/plugin-sdk": "file:.repodesk/sdk/plugin"
  }
}
