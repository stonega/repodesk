{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "version": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "apiVersion": {
      "type": "string",
      "const": "1"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "repository": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^https:\\/\\/github\\.com\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
    },
    "publisher": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "node-sandbox"
        },
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": ["type", "entry"],
      "additionalProperties": false
    },
    "capabilities": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["github.metadata.read", "http.read"]
      }
    },
    "settingsSchema": {
      "$ref": "#/$defs/__schema0"
    },
    "settingsUi": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 100
          },
          "help": {
            "type": "string",
            "maxLength": 1024
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64
          }
        },
        "required": ["label"],
        "additionalProperties": false
      }
    },
    "connections": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "scope": {
            "type": "string",
            "enum": ["member", "workspace"]
          },
          "auth": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["none", "bearer"]
              }
            },
            "required": ["type"],
            "additionalProperties": false
          },
          "requests": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "origin": {
                  "type": "string",
                  "maxLength": 2048
                },
                "paths": {
                  "minItems": 1,
                  "maxItems": 32,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "queryKeys": {
                  "maxItems": 32,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
                  }
                }
              },
              "required": ["origin", "paths", "queryKeys"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "name", "scope", "auth", "requests"],
        "additionalProperties": false
      }
    },
    "diagnosticCodes": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "tools": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "effect": {
            "type": "string",
            "enum": ["compute", "read"]
          },
          "capabilities": {
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["github.metadata.read", "http.read"]
            }
          },
          "inputSchema": {
            "$ref": "#/$defs/__schema0"
          },
          "outputSchema": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "name",
          "title",
          "description",
          "effect",
          "capabilities",
          "inputSchema",
          "outputSchema"
        ],
        "additionalProperties": false
      }
    },
    "skills": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 100
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1024
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "version",
    "apiVersion",
    "license",
    "repository",
    "publisher",
    "runtime",
    "capabilities",
    "settingsSchema",
    "tools",
    "skills"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "object",
            "array",
            "string",
            "integer",
            "number",
            "boolean",
            "null"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 100
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "additionalProperties": {
          "type": "boolean",
          "const": false
        },
        "items": {
          "$ref": "#/$defs/__schema0"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64000
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64000
        },
        "minItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "enum": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "const": {
          "$ref": "#/$defs/__schema2"
        },
        "default": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    },
    "__schema2": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema2"
          }
        }
      ]
    },
    "__schema3": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema3"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema3"
          }
        }
      ]
    }
  }
}
