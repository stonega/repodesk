{
  "name": "repodesk",
  "version": "0.1.24",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "1.63.0",
    "@types/bun": "latest",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@hono/node-server": "^2.1.1",
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "hono": "^4.13.8",
    "marked": "18.0.13",
    "pg": "8.20.0",
    "pg-boss": "12.33.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "7.13.1",
    "reicon-react": "1.2.5",
    "typebox": "1.3.7",
    "unpdf": "1.8.1",
    "zod": "4.3.6"
  },
  "description": "Telegram team assistant with Pi, PostgreSQL and an authenticated admin panel",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "local:start": "bash scripts/start-local.sh",
