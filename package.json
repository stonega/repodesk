{
  "name": "deepx-code-telegram-bot",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "latest",
    "@types/node": "^24",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8"
  },
  "description": "Telegram team agent: product research and backend scaffold",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target node --packages external",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start": "node dist/server.js"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
