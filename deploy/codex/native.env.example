# Install privately as /etc/repodesk/codex-native.env (mode 600).
CODEX_CONTAINER_ENGINE=native
CODEX_NATIVE_ENABLED=true
CODEX_NATIVE_CODEX_BIN=/usr/local/bin/codex
CODEX_RUNNER_STATE=/var/lib/repodesk-codex
CODEX_RUNNER_TOKEN=replace-with-a-private-token-of-at-least-32-characters
CODEX_RUNNER_LISTEN_HOST=127.0.0.1
CODEX_RUNNER_PROXY_URL=http://127.0.0.1:3020
# Provider and account credentials are configured in Plugins > Codex.
# Optional fallback: CODEX_PROVIDER_API_KEY (never inherit the operator's environment).
