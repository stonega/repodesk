[Unit]
Description=RepoDesk native Codex runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=repodesk-codex
Group=repodesk-codex
WorkingDirectory=/opt/repodesk
EnvironmentFile=/etc/repodesk/codex-native.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node /opt/repodesk/dist/runner-server.js
StateDirectory=repodesk-codex
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
KillMode=control-group
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
