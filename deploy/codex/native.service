[Unit]
Description=Telo native Codex runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telo-codex
Group=telo-codex
WorkingDirectory=/opt/telo
EnvironmentFile=/etc/telo/codex-native.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node /opt/telo/dist/runner-server.js
StateDirectory=telo-codex
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
KillMode=control-group
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
